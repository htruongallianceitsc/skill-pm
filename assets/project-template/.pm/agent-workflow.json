{
  "schemaVersion": "1.0",
  "planning": {
    "requireApprovalBeforeExecute": true,
    "protectAgainstStaleContext": true,
    "maxSteps": 100,
    "allowedOperations": [
      "create",
      "update",
      "content-upsert",
      "link",
      "unlink",
      "transition",
      "delete",
      "restore"
    ],
    "requireReason": true,
    "requireAcceptanceCriteria": false,
    "defaultContextProfile": "context",
    "defaultImpactProfile": "impact"
  },
  "execution": {
    "atomic": true,
    "validateAfterPlan": true,
    "runQualityAfterPlan": true,
    "blockAtQualitySeverity": "error",
    "createSingleChangeSet": true,
    "stopOnStepFailure": true,
    "qualityMode": "no-new-blocking"
  },
  "review": {
    "approvalInvalidatedByRefresh": true,
    "requireReasonForReject": true
  },
  "sync": {
    "enabled": true,
    "bidirectional": true
  }
}

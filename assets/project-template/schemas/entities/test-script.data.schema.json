{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test script data",
  "type": "object",
  "properties": {
    "framework": {
      "type": "string",
      "enum": [
        "playwright",
        "cypress",
        "flutter_test",
        "xunit",
        "other"
      ],
      "default": "playwright",
      "x-lookup": "testFramework"
    },
    "language": {
      "type": "string",
      "default": "typescript"
    },
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "sourcePath": {
      "type": [
        "string",
        "null"
      ],
      "description": "Project-relative executable test script path."
    },
    "testCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Discovered test-title/line evidence."
    }
  },
  "required": [],
  "additionalProperties": true
}

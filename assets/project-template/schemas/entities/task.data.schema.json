{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task data",
  "type": "object",
  "properties": {
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "default": "normal",
      "x-lookup": "priority"
    },
    "taskType": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "development",
        "analysis",
        "design",
        "testing",
        "ops",
        null
      ],
      "x-lookup": "taskType"
    },
    "assignee": {
      "type": [
        "string",
        "null"
      ]
    },
    "dueDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "estimateHours": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "actualHours": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [],
  "additionalProperties": true
}

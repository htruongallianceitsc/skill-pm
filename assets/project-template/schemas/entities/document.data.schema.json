{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document data",
  "type": "object",
  "properties": {
    "documentType": {
      "type": "string",
      "default": "general",
      "x-ui": {
        "widget": "text"
      }
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourcePath": {
      "type": [
        "string",
        "null"
      ],
      "description": "Project-relative source file imported or referenced by this document."
    },
    "diagramKind": {
      "type": [
        "string",
        "null"
      ]
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ]
    },
    "relatedRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "freshness": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "untracked",
            "current",
            "stale",
            "waived"
          ]
        },
        "reconciledAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uid": {
                "type": "string"
              },
              "revision": {
                "type": "integer"
              },
              "payloadHash": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "uid",
              "revision"
            ],
            "additionalProperties": true
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "required": [],
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document data",
  "type": "object",
  "properties": {
    "documentType": {
      "type": "string",
      "default": "general",
      "x-ui": {
        "widget": "text"
      }
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourcePath": {
      "type": [
        "string",
        "null"
      ],
      "description": "Project-relative source file imported or referenced by this document."
    },
    "diagramKind": {
      "type": [
        "string",
        "null"
      ]
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ]
    },
    "relatedRef": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [],
  "additionalProperties": true
}

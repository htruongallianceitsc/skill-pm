{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Module data",
  "type": "object",
  "properties": {
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "order": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "moduleType": {
      "type": "string",
      "const": "feature-group",
      "default": "feature-group",
      "description": "Module is a functional group of features."
    },
    "purpose": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [],
  "additionalProperties": true
}

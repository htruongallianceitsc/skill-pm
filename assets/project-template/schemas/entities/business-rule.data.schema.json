{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business rule data",
  "type": "object",
  "properties": {
    "ruleType": {
      "type": "string",
      "default": "general"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "default": "normal",
      "x-lookup": "priority"
    },
    "expression": {
      "type": [
        "string",
        "null"
      ]
    },
    "effectiveFrom": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effectiveTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [],
  "additionalProperties": true
}

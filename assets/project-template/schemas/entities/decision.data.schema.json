{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision data",
  "type": "object",
  "properties": {
    "decisionType": {
      "type": "string",
      "default": "general"
    },
    "context": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "consequences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ]
    },
    "decidedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "decidedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [],
  "additionalProperties": true
}
